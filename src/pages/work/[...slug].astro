---
import type { CollectionEntry } from 'astro:content';

import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getWorkCollection } from '../../data/work';

interface Props {
	entry: CollectionEntry<'work'>;
}

// Une page par fichier Markdown de src/content/work/. Le chargement passe par
// getWorkCollection, qui echoue si les deux langues ont diverge : c'est ici que
// la generation des routes le rendrait visible en premier.
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
	const work = await getWorkCollection('fr');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<ProjectLayout entry={entry} lang="fr" />
