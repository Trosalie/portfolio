---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkCollection } from '../../data/work';

interface Props {
	entry: CollectionEntry<'work'>;
}

// Une page par fichier Markdown de src/content/work/. Le chargement passe par
// getWorkCollection, qui echoue si les deux langues n'ont pas les memes slugs :
// c'est ici que la generation des routes le rendrait visible en premier.
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
	const work = await getWorkCollection('fr');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="stack gap-20">
		{/* Le <h1> du projet vivait dans un <header> hors du <main>, qui se
		    mappait sur un repere `banner` sans contenir la navigation. */}
		<main id="main-content" tabindex="-1" class="stack gap-15">
			<div class="project-header">
				<div class="wrapper stack gap-2">
					<a class="back-link" href="/work/"><Icon icon="arrow-left" /> Retour aux projets</a>
					<Hero title={entry.data.title} align="start">
						<div class="details">
							<div class="tags">
								{entry.data.tags.map((t) => <Pill>{t}</Pill>)}
							</div>
							<p class="description">{entry.data.description}</p>
							{entry.data.githubUrl && (
								<a class="github-link" href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer">
									<Icon icon="github-logo" />
									Voir sur GitHub
								</a>
							)}
						</div>
					</Hero>
				</div>
			</div>
			<div class="wrapper">
				<div class="stack gap-10 content">
					{/* Ici l'image est dans le flux : sans dimensions declarees elle
					    occupait une hauteur nulle puis poussait le contenu au
					    chargement. `<Image>` les deduit du fichier source. */}
					{entry.data.img && (
						<Image src={entry.data.img} alt={entry.data.img_alt || ''} loading="lazy" decoding="async" />
					)}
					<div class="content">
						<Content />
					</div>
				</div>
			</div>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.project-header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 0.5rem;
		color: var(--gray-300);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 500;
		align-self: flex-start;
		transition: border-color var(--theme-transition), color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1.25rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border: 1px solid var(--gray-800);
		border-radius: 0.5rem;
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 500;
		transition: border-color var(--theme-transition), color var(--theme-transition);
	}

	.github-link:hover,
	.github-link:focus {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.github-link :global(svg) {
		width: 1.2em;
		height: 1.2em;
	}

	.description {
		font-size: var(--text-lg);
		max-width: 54ch;
	}

	.content {
		max-width: 65ch;
		margin-inline: auto;
		overflow-x: hidden;
		word-break: break-word;
		overflow-wrap: break-word;
	}

	.content :global(table) {
		width: 100%;
		table-layout: auto;
		border-collapse: separate;
		border-spacing: 0;
		margin: 1.5rem 0;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		background: color-mix(in srgb, var(--gray-999) 92%, var(--gray-900) 8%);
		box-shadow: var(--shadow-sm);
	}

	.content :global(table thead) {
		background: color-mix(in srgb, var(--gray-900) 14%, var(--gray-999) 86%);
	}

	.content :global(table th),
	.content :global(table td) {
		padding: 0.75rem 1rem;
		text-align: left;
		line-height: 1.4;
		vertical-align: top;
		white-space: normal;
		word-break: break-word;
		border-bottom: 1px solid var(--gray-800);
	}

	.content :global(table th) {
		font-weight: 700;
		color: var(--gray-100);
	}

	.content :global(table td) {
		color: var(--gray-200);
	}

	.content :global(table th + th),
	.content :global(table td + td) {
		border-left: 1px solid var(--gray-800);
	}

	.content :global(table tbody tr:last-child td) {
		border-bottom: none;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.content :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.details {
			flex-direction: row;
			gap: 2.5rem;
		}

		.content :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>
