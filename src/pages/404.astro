---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

// Un hebergement statique ne sert qu'une seule page d'erreur, a la racine :
// c'est donc la langue par defaut du site qui s'applique ici.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('404.meta.title')} description={t('404.meta.desc')}>
	<main id="main-content" tabindex="-1" class="wrapper not-found">
		<h1>{t('404.title')}</h1>
		<p>{t('404.tagline')}</p>
		<a href="/">{t('404.back')}</a>
	</main>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	h1 {
		font-size: clamp(var(--step-4), 4vw, var(--step-5));
		letter-spacing: -0.02em;
	}

	p {
		font-size: var(--step-1);
		color: var(--ink-muted);
	}

	a {
		font-weight: 600;
	}
</style>
