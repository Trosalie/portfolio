---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('letter.meta.title')} description={t('letter.meta.desc')}>
	<main class="letter-editor-page wrapper">
		<section class="editor-panel" aria-label="Cover letter editor">
			<header class="editor-head">
				<h1>{t('letter.page.title')}</h1>
				<p>{t('letter.page.subtitle')}</p>
			</header>

			<div class="meta-fields">
				<div class="field-group">
					<label class="field" for="letter-date">{t('letter.form.date')}</label>
					<input id="letter-date" class="text-input" type="date" />
				</div>
				<div class="field-group">
					<label class="field" for="letter-company">{t('letter.form.company')}</label>
					<input id="letter-company" class="text-input" type="text" placeholder={t('letter.form.company.placeholder')} />
				</div>
				<div class="field-group field-group--full">
					<label class="field" for="letter-address">{t('letter.form.address')}</label>
					<input id="letter-address" class="text-input" type="text" placeholder={t('letter.form.address.placeholder')} />
				</div>
				<div class="field-group field-group--full">
					<label class="field" for="letter-subject">{t('letter.form.title')}</label>
					<input id="letter-subject" class="text-input" type="text" placeholder={t('letter.form.title.placeholder')} />
				</div>
			</div>

			<label class="field" for="letter-content">{t('letter.form.label')}</label>
			<textarea id="letter-content" class="letter-textarea" placeholder={t('letter.form.placeholder')}></textarea>

			<div class="actions">
				<a href="/en/letter-print/" target="_blank" rel="noopener" class="btn-download" id="open-print">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
					</svg>
					{t('letter.form.cta')}
				</a>
			</div>
		</section>

		<section class="preview-panel" aria-label="Cover letter preview">
			<article class="letter-card" id="letter-preview">
				<header class="letter-header">
					<h2 class="name">Thibault <span>Rosalie</span></h2>
					<p class="title">{t('letter.preview.header')}</p>
				</header>
				<div class="letter-meta">
					<p class="letter-meta-date" id="preview-date"></p>
					<p class="letter-meta-company" id="preview-company"></p>
					<p class="letter-meta-address" id="preview-address"></p>
					<p class="letter-meta-subject" id="preview-subject"></p>
				</div>
				<div class="letter-body" id="preview-content"></div>
			</article>
		</section>
	</main>
</BaseLayout>

<script>
	const storageKey = 'motivation-letter-en';
	const metaStorageKey = 'motivation-letter-meta-en';
	const defaultText = `Dear Hiring Manager,\n\nI am currently a third-year Computer Science student and I am eager to join your team to apply my full-stack development skills in a professional environment.\n\nI am rigorous, curious, and motivated by concrete technical challenges as well as collaborative work.\n\nI would be pleased to discuss how my profile could contribute to your projects.\n\nYours faithfully,\n\nThibault Rosalie`;
	const today = new Date().toISOString().slice(0, 10);

	type LetterMeta = {
		date: string;
		company: string;
		address: string;
		subject: string;
	};

	const defaultMeta: LetterMeta = {
		date: today,
		company: '',
		address: '',
		subject: 'Subject: Application',
	};

	const textarea = document.getElementById('letter-content');
	const preview = document.getElementById('preview-content');
	const openPrint = document.getElementById('open-print');
	const dateInput = document.getElementById('letter-date');
	const companyInput = document.getElementById('letter-company');
	const addressInput = document.getElementById('letter-address');
	const subjectInput = document.getElementById('letter-subject');
	const previewDate = document.getElementById('preview-date');
	const previewCompany = document.getElementById('preview-company');
	const previewAddress = document.getElementById('preview-address');
	const previewSubject = document.getElementById('preview-subject');

	const renderPreview = (text: string) => {
		if (!preview) return;
		const safe = text && text.trim() ? text : defaultText;
		preview.innerHTML = '';

		safe
			.split(/\n\s*\n/)
			.map((p: string) => p.trim())
			.filter(Boolean)
			.forEach((p: string) => {
				const el = document.createElement('p');
				el.textContent = p;
				preview.appendChild(el);
			});
	};

	const sync = (text: string) => {
		localStorage.setItem(storageKey, text);
		renderPreview(text);
	};

	const formatDate = (raw: string) => {
		if (!raw) return '';
		const date = new Date(raw);
		if (Number.isNaN(date.getTime())) return raw;
		return date.toLocaleDateString('en-GB');
	};

	const readMetaFromInputs = (): LetterMeta => ({
		date: dateInput instanceof HTMLInputElement ? dateInput.value : '',
		company: companyInput instanceof HTMLInputElement ? companyInput.value : '',
		address: addressInput instanceof HTMLInputElement ? addressInput.value : '',
		subject: subjectInput instanceof HTMLInputElement ? subjectInput.value : '',
	});

	const renderMeta = (meta: LetterMeta) => {
		if (previewDate) previewDate.textContent = formatDate(meta.date || defaultMeta.date);
		if (previewCompany) previewCompany.textContent = meta.company;
		if (previewAddress) previewAddress.textContent = meta.address;
		if (previewSubject) previewSubject.textContent = meta.subject;
	};

	const syncMeta = () => {
		const meta = readMetaFromInputs();
		localStorage.setItem(metaStorageKey, JSON.stringify(meta));
		renderMeta(meta);
	};

	const setMetaInputs = (meta: LetterMeta) => {
		if (dateInput instanceof HTMLInputElement) dateInput.value = meta.date;
		if (companyInput instanceof HTMLInputElement) companyInput.value = meta.company;
		if (addressInput instanceof HTMLInputElement) addressInput.value = meta.address;
		if (subjectInput instanceof HTMLInputElement) subjectInput.value = meta.subject;
	};

	const loadMeta = (): LetterMeta => {
		const raw = localStorage.getItem(metaStorageKey);
		if (!raw) return defaultMeta;
		try {
			const parsed = JSON.parse(raw);
			return {
				date: typeof parsed.date === 'string' && parsed.date ? parsed.date : defaultMeta.date,
				company: typeof parsed.company === 'string' ? parsed.company : defaultMeta.company,
				address: typeof parsed.address === 'string' ? parsed.address : defaultMeta.address,
				subject: typeof parsed.subject === 'string' && parsed.subject ? parsed.subject : defaultMeta.subject,
			};
		} catch {
			return defaultMeta;
		}
	};

	if (textarea instanceof HTMLTextAreaElement) {
		const saved = localStorage.getItem(storageKey) ?? defaultText;
		textarea.value = saved;
		renderPreview(saved);
		textarea.addEventListener('input', (event: Event) => {
			const target = event.currentTarget;
			if (target instanceof HTMLTextAreaElement) {
				sync(target.value);
			}
		});
	}

	const initialMeta = loadMeta();
	setMetaInputs(initialMeta);
	renderMeta(initialMeta);

	[dateInput, companyInput, addressInput, subjectInput].forEach((input) => {
		input?.addEventListener('input', syncMeta);
	});

	openPrint?.addEventListener('click', () => {
		if (textarea instanceof HTMLTextAreaElement) {
			sync(textarea.value);
		}
		syncMeta();
	});
</script>

<style>
	.letter-editor-page {
		display: grid;
		gap: 1.5rem;
		padding-top: 2rem;
		padding-bottom: 4rem;
	}

	.editor-panel,
	.preview-panel {
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		box-shadow: var(--shadow-md);
		padding: 1.25rem;
	}

	.editor-head h1 {
		font-size: var(--text-3xl);
		margin-bottom: 0.5rem;
	}

	.editor-head p {
		color: var(--gray-300);
		max-width: 62ch;
		margin-bottom: 1rem;
	}

	.field {
		display: inline-block;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.meta-fields {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.field-group {
		display: flex;
		flex-direction: column;
	}

	.text-input {
		width: 100%;
		padding: 0.72rem 0.85rem;
		font: inherit;
		color: var(--gray-100);
		background: var(--gray-999);
		border: 1px solid var(--gray-700);
		border-radius: 0.75rem;
	}

	.text-input:focus {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}

	.letter-textarea {
		width: 100%;
		min-height: 360px;
		resize: vertical;
		padding: 1rem;
		font: inherit;
		line-height: 1.6;
		color: var(--gray-100);
		background: var(--gray-999);
		border: 1px solid var(--gray-700);
		border-radius: 0.75rem;
	}

	.letter-textarea:focus {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}

	.actions {
		margin-top: 1rem;
		display: flex;
		justify-content: flex-end;
	}

	.btn-download {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--gradient-accent);
		color: var(--accent-text-over);
		padding: 0.6rem 1.25rem;
		border-radius: 999px;
		font-size: var(--text-sm);
		font-weight: 600;
		text-decoration: none;
		transition: opacity var(--theme-transition), box-shadow var(--theme-transition);
		box-shadow: var(--shadow-md);
	}

	.btn-download:hover {
		opacity: 0.85;
		box-shadow: var(--shadow-lg);
	}

	.letter-card {
		background: #ffffff;
		border-radius: 0.85rem;
		overflow: hidden;
		border: 1px solid var(--gray-800);
	}

	.letter-header {
		background: var(--gradient-accent);
		color: #ffffff;
		padding: 1.5rem 1.75rem;
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		align-items: baseline;
	}

	.name {
		margin: 0;
		font-family: var(--font-brand);
		font-size: clamp(1.4rem, 3.2vw, 2rem);
		font-weight: 700;
	}

	.name span {
		font-weight: 300;
	}

	.title {
		margin: 0;
		letter-spacing: 0.1em;
		font-size: var(--text-sm);
		text-transform: uppercase;
		opacity: 0.92;
	}

	.letter-body {
		padding: 1.5rem 1.75rem 1.75rem;
		color: #090b11;
		line-height: 1.75;
		font-size: 0.98rem;
	}

	.letter-meta {
		padding: 1rem 1.75rem 0;
		font-size: 0.9rem;
		line-height: 1.5;
		color: #283044;
	}

	.letter-meta p {
		margin: 0;
	}

	.letter-meta-subject {
		margin-top: 0.65rem !important;
		font-weight: 700;
		color: #1c0056;
	}

	.letter-body p + p {
		margin-top: 1rem;
	}

	@media (min-width: 62em) {
		.letter-editor-page {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
			align-items: start;
		}

		.meta-fields {
			grid-template-columns: 1fr 1fr;
		}

		.field-group--full {
			grid-column: 1 / -1;
		}

		.preview-panel {
			position: sticky;
			top: 1.25rem;
		}
	}
</style>
