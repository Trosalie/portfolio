---
import type { CollectionEntry } from 'astro:content';

import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { getWorkCollection } from '../../../data/work';

interface Props {
	entry: CollectionEntry<'work-en'>;
}

// Pendant anglais de src/pages/work/[...slug].astro : memes slugs, collection
// `work-en`. Toute la mise en page vit dans ProjectLayout.
export async function getStaticPaths() {
	const work = await getWorkCollection('en');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<ProjectLayout entry={entry} lang="en" />
