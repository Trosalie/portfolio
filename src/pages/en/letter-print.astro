---
// Cover letter print page (EN)
---

<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="robots" content="noindex, nofollow" />
	<title>Cover Letter - Thibault Rosalie (print)</title>

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;700&family=Rubik:wght@300;500;700&display=swap"
		rel="stylesheet"
	/>

	<style>
		*, *::before, *::after { box-sizing: border-box; }

		body {
			margin: 0;
			padding: 0;
			background: #e8e8e8;
			font-family: 'Public Sans', system-ui, sans-serif;
			font-size: 14px;
			color: #090b11;
		}

		.print-toolbar {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 100;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.6rem 1.5rem;
			background: #1c0056;
			color: #fff;
			box-shadow: 0 2px 8px rgba(0,0,0,0.3);
		}

		.print-toolbar-title {
			font-family: 'Rubik', sans-serif;
			font-size: 0.9rem;
			font-weight: 500;
			letter-spacing: 0.04em;
			opacity: 0.85;
		}

		.print-toolbar-actions {
			display: flex;
			gap: 0.75rem;
		}

		.btn-print {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			background: linear-gradient(150deg, #c561f6, #7611a6);
			color: #fff;
			border: none;
			border-radius: 999px;
			padding: 0.45rem 1.1rem;
			font-size: 0.82rem;
			font-weight: 700;
			cursor: pointer;
			letter-spacing: 0.03em;
		}

		.btn-back {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			background: transparent;
			color: rgba(255,255,255,0.7);
			border: 1px solid rgba(255,255,255,0.25);
			border-radius: 999px;
			padding: 0.45rem 1rem;
			font-size: 0.82rem;
			text-decoration: none;
		}

		.letter-page-wrapper {
			padding-top: calc(44px + 1.5rem);
			padding-bottom: 2rem;
			display: flex;
			justify-content: center;
		}

		.letter-page {
			width: 210mm;
			min-height: 297mm;
			background: #fff;
			box-shadow: 0 4px 32px rgba(0,0,0,0.22);
			overflow: hidden;
			display: flex;
			flex-direction: column;
		}

		.letter-header {
			background: linear-gradient(150deg, #c561f6, #7611a6, #1c0056);
			color: #fff;
			padding: 1.5rem 2rem;
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 0.75rem;
		}

		.letter-name {
			font-family: 'Rubik', sans-serif;
			font-size: 1.9rem;
			font-weight: 700;
			margin: 0;
		}

		.letter-name span { font-weight: 300; }

		.letter-title {
			margin: 0;
			font-size: 0.85rem;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			opacity: 0.9;
		}

		.letter-content {
			padding: 1.8rem 2rem 2rem;
			line-height: 1.72;
			font-size: 0.98rem;
			color: #090b11;
		}

		.letter-meta {
			padding: 1.2rem 2rem 0;
			font-size: 0.9rem;
			line-height: 1.5;
			color: #283044;
		}

		.letter-meta p {
			margin: 0;
		}

		.letter-meta-subject {
			margin-top: 0.65rem !important;
			font-weight: 700;
			color: #1c0056;
		}

		.letter-content p {
			margin: 0;
		}

		.letter-content p + p {
			margin-top: 0.95rem;
		}

		@media print {
			@page {
				size: A4 portrait;
				margin: 0;
			}

			*, *::before, *::after {
				-webkit-print-color-adjust: exact !important;
				print-color-adjust: exact !important;
			}

			.print-toolbar { display: none !important; }

			body {
				background: none;
				padding: 0;
				margin: 0;
			}

			.letter-page-wrapper {
				padding: 0;
				display: block;
			}

			.letter-page {
				width: 100%;
				min-height: 297mm;
				box-shadow: none;
			}
		}
	</style>
</head>
<body>
	<div class="print-toolbar">
		<span class="print-toolbar-title">Print preview - Cover Letter</span>
		<div class="print-toolbar-actions">
			<a href="/en/letter/" class="btn-back">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
				Back
			</a>
			<button class="btn-print" onclick="window.print()">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
				Print / Save as PDF
			</button>
		</div>
	</div>

	<div class="letter-page-wrapper">
		<div class="letter-page" role="main" aria-label="Cover letter of Thibault Rosalie">
			<header class="letter-header">
				<h1 class="letter-name">Thibault <span>Rosalie</span></h1>
				<p class="letter-title">Cover Letter</p>
			</header>
			<section class="letter-meta">
				<p id="letter-date">19/03/2026</p>
				<p id="letter-company">Company name</p>
				<p id="letter-address">Company address</p>
				<p class="letter-meta-subject" id="letter-subject">Subject: Application</p>
			</section>
			<section class="letter-content" id="letter-content">
				<p>Dear Hiring Manager,</p>
				<p>I am currently a third-year Computer Science student and I am eager to join your team to apply my full-stack development skills in a professional environment.</p>
				<p>I am rigorous, curious, and motivated by concrete technical challenges as well as collaborative work.</p>
				<p>I would be pleased to discuss how my profile could contribute to your projects.</p>
				<p>Yours faithfully,</p>
				<p>Thibault Rosalie</p>
			</section>
		</div>
	</div>

	<script>
		const storageKey = 'motivation-letter-en';
		const metaStorageKey = 'motivation-letter-meta-en';
		const target = document.getElementById('letter-content');
		const text = localStorage.getItem(storageKey);
		const metaDate = document.getElementById('letter-date');
		const metaCompany = document.getElementById('letter-company');
		const metaAddress = document.getElementById('letter-address');
		const metaSubject = document.getElementById('letter-subject');

		if (target && text && text.trim()) {
			target.innerHTML = '';
			text
				.split(/\n\s*\n/)
				.map((p) => p.trim())
				.filter(Boolean)
				.forEach((p) => {
					const el = document.createElement('p');
					el.textContent = p;
					target.appendChild(el);
				});
		}

		const formatDate = (raw: string) => {
			if (!raw) return '';
			const date = new Date(raw);
			if (Number.isNaN(date.getTime())) return raw;
			return date.toLocaleDateString('en-GB');
		};

		const rawMeta = localStorage.getItem(metaStorageKey);
		if (rawMeta) {
			try {
				const meta = JSON.parse(rawMeta);
				if (metaDate) metaDate.textContent = formatDate(meta.date || '');
				if (metaCompany) metaCompany.textContent = meta.company || '';
				if (metaAddress) metaAddress.textContent = meta.address || '';
				if (metaSubject) metaSubject.textContent = meta.subject || 'Subject: Application';
			} catch {
				// Ignore invalid stored metadata
			}
		}
	</script>
</body>
</html>
