---
/**
 * Une section de page projet : un titre ordinaire, puis le contenu.
 *
 * L'intitule vient toujours de l'i18n et jamais du contenu — c'est ce qui
 * garantit qu'un projet ne peut plus nommer ses sections differemment d'une
 * langue a l'autre, comme c'etait le cas quand elles vivaient en `##` dans le
 * corps Markdown.
 */
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="project-section">
	<h2>{title}</h2>
	<slot />
</section>

<style>
	.project-section {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	h2 {
		font-size: var(--step-3);
	}

	@media (min-width: 50em) {
		.project-section {
			gap: 1.5rem;
		}
	}
</style>
