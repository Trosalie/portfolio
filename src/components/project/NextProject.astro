---
import ProjectFrame from '../work/ProjectFrame.astro';
import { workBasePath, type WorkEntry } from '../../data/work';
import { useTranslations, type Lang } from '../../i18n/ui';

/**
 * Le lien vers le projet suivant, en pied de page projet : le libelle, puis le
 * cadre du projet suivant avec son nom dans sa police. Un seul lien, sans
 * fleche ; son nom accessible reprend le libelle et le titre.
 */
interface Props {
	entry: WorkEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const label = t('work.next.label').replace('{title}', entry.data.title);
---

<a class="next-project" href={`${workBasePath(lang)}${entry.id}`} aria-label={label}>
	<span class="next-label">{t('work.next')}</span>
	<ProjectFrame entry={entry} variant="band" />
</a>

<style>
	/* Un bloc et non un lien en ligne : l'anneau de focus entoure alors le
	   libelle et le cadre d'un seul trait. */
	.next-project {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		color: inherit;
		text-decoration: none;
	}

	.next-label {
		font-weight: 600;
	}

	.next-project:hover :global(.frame-title) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
