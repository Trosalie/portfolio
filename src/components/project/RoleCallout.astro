---
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<p class="role">{text}</p>

<style>
	.role {
		margin: 0;
		padding: 1.25rem 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-regular);
		border-radius: 0 0.75rem 0.75rem 0;
		background-color: var(--gray-999_40);
		color: var(--gray-200);
		font-size: var(--text-base);
		line-height: 1.6;
	}

	@media (min-width: 50em) {
		.role {
			padding: 1.5rem 2rem;
			font-size: var(--text-md);
		}
	}
</style>
