---
interface Props {
	text: string;
}

const { text } = Astro.props;

// Une ligne vide separe deux paragraphes, comme en Markdown : un role qui
// raconte d'abord le contexte puis la technique se lit mieux en deux temps.
const paragraphs = text.trim().split(/\n\s*\n/);
---

<div class="role">
	{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
</div>

<style>
	/* Du texte courant, comme l'introduction : la section se lit, elle n'a pas
	   besoin d'un encadre pour etre remarquee depuis qu'elle vient en deuxieme. */
	.role {
		max-width: var(--measure);
		font-size: var(--step-1);
		line-height: 1.6;
	}

	.role p + p {
		margin-top: 0.75em;
	}
</style>
