---
import type { ProjectFeature } from '../../data/work';

interface Props {
	features: ProjectFeature[];
}

const { features } = Astro.props;
---

{/* Une liste simple : un titre, et sa precision quand elle existe. Les cartes
    et les icones qui l'habillaient n'ajoutaient aucune information. */}
<ul class="features">
	{
		features.map((feature) => (
			<li>
				<h3>{feature.title}</h3>
				{feature.description && <p>{feature.description}</p>}
			</li>
		))
	}
</ul>

<style>
	.features {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		max-width: var(--measure);
	}

	h3 {
		font-size: var(--step-0);
		line-height: 1.35;
	}

	p {
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	@media (min-width: 50em) {
		.features {
			grid-template-columns: 1fr 1fr;
			gap: 1.75rem 3rem;
		}
	}
</style>
