---
import { Image } from 'astro:assets';
import type { WorkEntry } from '../../data/work';

interface Props {
	entry: WorkEntry;
}

const { data } = Astro.props.entry;
---

{/* Le cadre porte le degrade du projet : quand la capture manque encore, il
    reste une couverture pleine plutot qu'un trou. Le ratio est fixe par CSS,
    donc la place est reservee avant meme le chargement de l'image. */}
<div
	class="cover"
	style={`background: ${data.gradient ?? 'var(--gradient-subtle)'}`}
	aria-hidden={data.img ? undefined : 'true'}
>
	{
		data.img && (
			<Image
				src={data.img}
				alt={data.img_alt!}
				widths={[640, 1024, 1600]}
				sizes="(min-width: 50em) 66rem, 100vw"
				loading="eager"
				decoding="async"
			/>
		)
	}
</div>

<style>
	.cover {
		position: relative;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 50em) {
		.cover {
			border-radius: 1.5rem;
			box-shadow: var(--shadow-md);
		}
	}
</style>
