---
import { workBasePath, type WorkEntry } from '../../data/work';
import { useTranslations, type Lang } from '../../i18n/ui';
import ProjectFacts from './ProjectFacts.astro';

interface Props {
	entry: WorkEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const { data } = entry;
const t = useTranslations(lang);
---

<div class="project-hero">
	<a class="back-link" href={workBasePath(lang)}>{t('work.back')}</a>
	<div class="hero-main">
		<h1>{data.title}</h1>
		<p class="description">{data.description}</p>
		{
			(data.githubUrl || data.demoUrl) && (
				<div class="actions">
					{data.demoUrl && (
						<a class="button" href={data.demoUrl} target="_blank" rel="noopener noreferrer">
							{t('work.demo')}
						</a>
					)}
					{data.githubUrl && (
						<a href={data.githubUrl} target="_blank" rel="noopener noreferrer">
							{t('work.github')}
						</a>
					)}
				</div>
			)
		}
	</div>
	<ProjectFacts entry={entry} lang={lang} />
</div>

<style>
	.project-hero,
	.hero-main {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	/* Sous 50em, la fiche suit les liens, dans l'ordre du document. A partir de
	   50em, elle se pose a droite du titre ; la colonne du texte garde la place
	   restante, la fiche est bornee pour ne pas l'ecraser. */
	@media (min-width: 50em) {
		.project-hero {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
			column-gap: clamp(2rem, 4vw, 3rem);
			row-gap: 1.25rem;
			align-items: start;
		}

		.back-link {
			grid-column: 1 / -1;
			justify-self: start;
		}
	}

	.back-link {
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	.back-link:hover {
		color: var(--ink);
	}

	h1 {
		font-size: clamp(var(--step-4), 4vw, var(--step-5));
		letter-spacing: -0.02em;
	}

	.description {
		max-width: var(--measure);
		font-size: var(--step-1);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		margin-top: 0.25rem;
		font-weight: 600;
	}

</style>
