---
import { workBasePath, type WorkEntry } from '../../data/work';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
	entry: WorkEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const { data } = entry;
const t = useTranslations(lang);

// Periode, cadre et equipe, une ligne chacun : recomposer une phrase obligerait
// a mettre en minuscule le debut de chaque element, et « SAÉ de BUT »
// deviendrait « sAÉ de BUT ».
const meta = [data.period, data.context, data.team].filter(Boolean) as string[];
---

<div class="project-hero">
	<a class="back-link" href={workBasePath(lang)}>{t('work.back')}</a>
	<h1>{data.title}</h1>
	<p class="description">{data.description}</p>
	{
		meta.length > 0 && (
			<ul class="meta">
				{meta.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		)
	}
	{
		(data.githubUrl || data.demoUrl) && (
			<div class="actions">
				{data.demoUrl && (
					<a class="button" href={data.demoUrl} target="_blank" rel="noopener noreferrer">
						{t('work.demo')}
					</a>
				)}
				{data.githubUrl && (
					<a href={data.githubUrl} target="_blank" rel="noopener noreferrer">
						{t('work.github')}
					</a>
				)}
			</div>
		)
	}
</div>

<style>
	.project-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	.back-link {
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	.back-link:hover {
		color: var(--ink);
	}

	h1 {
		font-size: clamp(var(--step-4), 4vw, var(--step-5));
		letter-spacing: -0.02em;
	}

	.description {
		max-width: var(--measure);
		font-size: var(--step-1);
	}

	.meta {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		margin-top: 0.25rem;
		font-weight: 600;
	}

	.button {
		padding: 0.7em 1.2em;
		border-radius: var(--radius);
		background: var(--ink);
		color: #fff;
		text-decoration: none;
	}

	.button:hover {
		background: #000;
	}
</style>
