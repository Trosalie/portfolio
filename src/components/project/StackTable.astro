---
import type { WorkEntry } from '../../data/work';

interface Props {
	stack: WorkEntry['data']['stack'];
}

const { stack } = Astro.props;
---

{/* Une liste de definitions plutot qu'un tableau : la relation est bien
    « une couche → ses technologies », et elle se replie proprement en colonne
    sous 50em. Les technologies s'ecrivent en texte, comme sur les etiquettes. */}
<dl class="stack-table">
	{
		stack.map((group) => (
			<div class="row">
				<dt>{group.layer}</dt>
				<dd>{group.items.join(', ')}</dd>
			</div>
		))
	}
</dl>

<style>
	.stack-table {
		margin: 0;
		max-width: 48rem;
		border-top: 1px solid var(--rule);
	}

	.row {
		display: grid;
		gap: 0.25rem;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--rule);
	}

	dt {
		font-weight: 600;
	}

	dd {
		margin: 0;
		color: var(--ink-muted);
	}

	@media (min-width: 50em) {
		.row {
			grid-template-columns: 12rem 1fr;
			gap: 2rem;
		}
	}
</style>
