---
import Icon from '../Icon.astro';
import type { ViewerCapture } from '../../data/captures';
import { frameStyle, type ProjectIdentity } from '../../data/identity';
import { useTranslations, type Lang } from '../../i18n/ui';

/**
 * La visionneuse des captures d'un projet, dans les couleurs de son cadre.
 *
 * Toutes les captures sont dans la page, une seule est affichee a la fois : dans
 * un `<dialog>` ferme, une image paresseuse n'est jamais telechargee. Sans
 * JavaScript rien ne l'ouvre, et les liens de la page menent aux images.
 * Voir docs/superpowers/specs/2026-11-24-visionneuse-design.md.
 */
interface Props {
	captures: ViewerCapture[];
	identity: ProjectIdentity | undefined;
	lang: Lang;
}

const { captures, identity, lang } = Astro.props;
const t = useTranslations(lang);
const several = captures.length > 1;

const numbered = (key: 'work.viewer.position' | 'work.gallery.position', index: number) =>
	t(key)
		.replace('{n}', String(index + 1))
		.replace('{total}', String(captures.length));
---

<dialog class="viewer" data-viewer aria-label={t('work.gallery.label')} style={frameStyle(identity?.frame)}>
	{
		several && (
			<p class="position" data-position>
				{numbered('work.viewer.position', 0)}
			</p>
		)
	}
	<form method="dialog" class="close">
		<button class="text-button" data-close autofocus>{t('work.viewer.close')}</button>
	</form>

	{/* La zone prend le focus pour defiler au clavier quand la capture est agrandie. */}
	<div class="stage" data-stage tabindex="0" role="group" aria-label={t('work.gallery.label')}>
		{
			captures.map((capture, index) => (
				<div
					class="capture"
					data-capture
					data-width={capture.src.width}
					data-height={capture.src.height}
					data-position-label={several ? numbered('work.viewer.position', index) : undefined}
					data-live={numbered('work.gallery.position', index)}
					hidden={index > 0}
				>
					<img
						src={capture.full}
						alt={capture.alt}
						width={capture.src.width}
						height={capture.src.height}
						loading="lazy"
						decoding="async"
					/>
				</div>
			))
		}
	</div>

	<div class="captions">
		{
			captures.map((capture, index) => (
				<p data-caption hidden={index > 0 || !capture.caption}>
					{capture.caption}
				</p>
			))
		}
	</div>

	{
		several && (
			<>
				<button type="button" class="arrow prev" data-prev aria-label={t('work.gallery.previous')}>
					<Icon icon="arrow-left" size="1.25rem" />
				</button>
				<button type="button" class="arrow next" data-next aria-label={t('work.gallery.next')}>
					<Icon icon="arrow-right" size="1.25rem" />
				</button>
			</>
		)
	}
	<button
		type="button"
		class="text-button toggle"
		data-toggle
		data-zoom-label={t('work.viewer.open')}
		data-fit-label={t('work.viewer.fit')}>{t('work.viewer.open')}</button
	>

	<p class="sr-only" aria-live="polite" data-live-region></p>
</dialog>

<script>
	import { captureSizes } from '../../data/captures';

	const SMALL = window.matchMedia('(max-width: 49.99em), (max-height: 29.99em)');
	const PAN = 120;

	const modified = (event: MouseEvent | KeyboardEvent) =>
		event.ctrlKey || event.metaKey || event.shiftKey || event.altKey;

	function setupViewer(dialog: HTMLDialogElement) {
		const find = <T extends HTMLElement>(name: string) => dialog.querySelector<T>(`[data-${name}]`);
		const stage = find('stage')!;
		const toggle = find<HTMLButtonElement>('toggle')!;
		const position = find('position');
		const live = find('live-region')!;
		const prev = find('prev');
		const next = find('next');
		const captures = [...dialog.querySelectorAll<HTMLElement>('[data-capture]')];
		const captions = [...dialog.querySelectorAll<HTMLElement>('[data-caption]')];

		let current = 0;
		let zoomed = false;
		let opener: HTMLElement | null = null;

		const image = () => captures[current]!.querySelector('img')!;

		// La zone se mesure barres de defilement comprises : leur apparition ne doit
		// pas changer la taille qui les a fait apparaitre.
		const sizes = () => {
			const { width, height } = captures[current]!.dataset;
			return captureSizes(
				stage.getBoundingClientRect(),
				{ width: Number(width), height: Number(height) },
				SMALL.matches,
			);
		};

		const resize = () => {
			const { fit, zoom, canZoom } = sizes();
			image().style.width = `${zoomed ? zoom : fit}px`;
			toggle.hidden = !canZoom;
			toggle.textContent = (zoomed ? toggle.dataset.fitLabel : toggle.dataset.zoomLabel) ?? '';
			dialog.dataset.size = zoomed && canZoom ? 'zoom' : 'fit';
			dialog.toggleAttribute('data-zoomable', canZoom);
		};

		const show = (index: number) => {
			current = index;
			dialog.dataset.index = String(index);
			captures.forEach((capture, i) => (capture.hidden = i !== index));
			captions.forEach((caption, i) => (caption.hidden = i !== index || !caption.textContent?.trim()));
			if (position) position.textContent = captures[index]!.dataset.positionLabel ?? '';
			prev?.setAttribute('aria-disabled', String(index === 0));
			next?.setAttribute('aria-disabled', String(index === captures.length - 1));
			// La legende vient de changer, et la zone avec elle : on mesure apres.
			zoomed = sizes().opensZoomed;
			resize();
			stage.scrollTo(0, 0);
		};

		const goTo = (index: number) => {
			if (index === current || index < 0 || index >= captures.length) return;
			show(index);
			live.textContent = captures[index]!.dataset.live ?? '';
		};

		// `at` : le point touche, en fraction de l'image, a garder sous les yeux.
		const setZoom = (value: boolean, at?: { x: number; y: number }) => {
			zoomed = value;
			resize();
			if (!at || !value) return;
			const { width, height } = image().getBoundingClientRect();
			stage.scrollTo(at.x * width - stage.clientWidth / 2, at.y * height - stage.clientHeight / 2);
		};

		document.querySelectorAll('a[data-viewer-open]').forEach((link) => link.setAttribute('aria-haspopup', 'dialog'));

		// Ecoute sur le document : la galerie passe avant et retient le clic qui ne
		// sert qu'a centrer une capture voisine.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as Element).closest<HTMLElement>('[data-viewer-open]');
			if (!trigger || event.defaultPrevented || event.button !== 0 || modified(event)) return;
			event.preventDefault();
			opener = trigger;
			live.textContent = '';
			dialog.showModal();
			show(Number(trigger.dataset.viewerOpen));
		});

		dialog.addEventListener('click', (event) => {
			// Le second clic d'un double-clic sur la page arrive ici : il n'a rien demande.
			if (event.detail > 1) return;
			const target = event.target as Element;
			if (target === image()) {
				if (!sizes().canZoom) return;
				const box = image().getBoundingClientRect();
				setZoom(!zoomed, { x: (event.clientX - box.left) / box.width, y: (event.clientY - box.top) / box.height });
				return;
			}
			const onScrollbar =
				target === stage && (event.offsetX >= stage.clientWidth || event.offsetY >= stage.clientHeight);
			if ((target === dialog || target === stage) && !onScrollbar) dialog.close();
		});

		toggle.addEventListener('click', () => setZoom(!zoomed));
		prev?.addEventListener('click', () => goTo(current - 1));
		next?.addEventListener('click', () => goTo(current + 1));

		dialog.addEventListener('keydown', (event) => {
			const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
			if (!step || modified(event)) return;
			event.preventDefault();
			if (dialog.dataset.size === 'zoom') stage.scrollBy({ left: step * PAN });
			else goTo(current + step);
		});

		// Ouverte depuis la galerie, la visionneuse y laisse la derniere capture vue ;
		// le focus suit, sauf si l'on etait parti du bouton « Agrandir ».
		dialog.addEventListener('close', () => {
			const last = opener
				?.closest('[data-gallery]')
				?.querySelector<HTMLElement>(`a[data-viewer-open="${current}"]`);
			last?.dispatchEvent(new CustomEvent('gallery:show', { bubbles: true }));
			const target = opener?.matches('a') ? (last ?? opener) : opener;
			target?.focus({ preventScroll: true });
		});

		new ResizeObserver(() => dialog.open && resize()).observe(stage);
	}

	document.querySelectorAll<HTMLDialogElement>('[data-viewer]').forEach(setupViewer);
</script>

<style>
	/* La page derriere ne defile pas tant que la visionneuse est ouverte. */
	:global(html:has(dialog.viewer[open])) {
		overflow: hidden;
	}

	.viewer {
		width: 100%;
		max-width: none;
		height: 100dvh;
		max-height: none;
		padding: 0.75rem 1rem;
		border: 0;
		background: var(--frame-bg);
		color: var(--frame-title);
	}

	.viewer::backdrop {
		background: none;
	}

	/* `display` ne va que sur la boite ouverte : fermee, elle doit rester masquee. */
	.viewer[open] {
		display: grid;
		grid-template:
			'head head head' auto
			'stage stage stage' minmax(0, 1fr)
			'captions captions captions' auto
			'prev toggle next' auto / 2.75rem minmax(0, 1fr) 2.75rem;
		gap: 0.75rem 1rem;
	}

	.viewer [hidden] {
		display: none;
	}

	.viewer :focus-visible {
		outline-color: var(--frame-title);
	}

	.position {
		grid-area: head;
		align-self: center;
	}

	.close {
		grid-area: head;
		justify-self: end;
	}

	.stage {
		grid-area: stage;
		display: flex;
		overflow: auto;
		overscroll-behavior: contain;
	}

	.stage:focus-visible {
		outline-offset: -2px;
	}

	/* `margin: auto` et non un centrage de la zone : une capture agrandie garde
	   ainsi son bord gauche atteignable. */
	.capture {
		flex: none;
		margin: auto;
	}

	.capture img {
		display: block;
		max-width: none;
	}

	[data-size='fit'][data-zoomable] .capture img {
		cursor: zoom-in;
	}

	[data-size='zoom'] .capture img {
		cursor: zoom-out;
	}

	.captions {
		grid-area: captions;
		max-width: var(--measure);
		font-size: var(--step--1);
		line-height: 1.4;
	}

	.text-button,
	.arrow {
		min-width: 2.75rem;
		min-height: 2.75rem;
		border: 0;
		border-radius: var(--radius);
		background: none;
		color: inherit;
		cursor: pointer;
	}

	.text-button {
		padding: 0 0.25rem;
		font: inherit;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.text-button:hover {
		text-decoration-thickness: 2px;
	}

	.toggle {
		grid-area: toggle;
		justify-self: center;
	}

	.arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 1px solid currentColor;
	}

	/* Au doigt, le survol resterait colore apres l'appui. */
	@media (hover: hover) {
		.arrow:hover:not([aria-disabled='true']) {
			background: var(--frame-title);
			color: var(--frame-bg);
		}
	}

	/* Indisponible : le bord disparait, la couleur reste pleine pour rester lisible. */
	.arrow[aria-disabled='true'] {
		border-color: transparent;
		cursor: default;
	}

	.prev {
		grid-area: prev;
	}

	.next {
		grid-area: next;
	}

	@media (min-width: 50em) {
		.viewer {
			padding: 0.75rem 1.5rem;
		}

		/* Les fleches encadrent la capture ; la legende et le bouton de taille
		   partagent la derniere rangee sans elargir la colonne de la fleche. */
		.viewer[open] {
			grid-template:
				'head head head' auto
				'prev stage next' minmax(0, 1fr)
				'captions captions captions' auto / 2.75rem minmax(0, 1fr) 2.75rem;
		}

		.arrow {
			align-self: center;
		}

		.captions {
			align-self: center;
			min-height: 2.75rem;
			display: flex;
			align-items: center;
			margin-right: 9rem;
		}

		.toggle {
			grid-area: captions;
			justify-self: end;
			align-self: center;
		}
	}
</style>
