---
/**
 * La page CV telle qu'elle est vue sur le site, dans les deux langues.
 *
 * `src/pages/cv.astro` et `src/pages/en/cv.astro` ne font plus que l'inclure :
 * elles portaient auparavant chacune 720 lignes, dont le CV entier et sa
 * feuille de style.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import CvDocument from './CvDocument.astro';
import '../styles/cv-screen.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Le PDF est produit au build par scripts/generate-cv-pdf.mjs a partir de la
// page d'impression correspondante.
const pdfHref = `/assets/pdf/CV_Thibault_Rosalie_${lang.toUpperCase()}.pdf`;
const printHref = lang === 'fr' ? '/cv-print/' : `/${lang}/cv-print/`;
---

<BaseLayout title={t('cv.meta.title')} description={t('cv.meta.desc')}>
	<main id="main-content" class="cv-wrapper">
		<div class="cv-actions">
			<a href={pdfHref} download class="btn-download btn-secondary">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
				</svg>
				{t('cv.download')}
			</a>
			<a href={printHref} target="_blank" rel="noopener" class="btn-download">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
				</svg>
				{t('cv.save')}
			</a>
		</div>

		<CvDocument lang={lang} />
	</main>
</BaseLayout>
