---
/**
 * La page CV telle qu'elle est vue sur le site, dans les deux langues.
 *
 * `src/pages/cv.astro` et `src/pages/en/cv.astro` ne font plus que l'inclure :
 * elles portaient auparavant chacune 720 lignes, dont le CV entier et sa
 * feuille de style.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import CvDocument from './CvDocument.astro';
// Les polices du PDF, installees avec le site comme pour les pages d'impression :
// le CV a l'ecran doit se lire comme celui qu'on telecharge.
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/rubik/300.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/700.css';
import '../styles/cv-screen.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Le PDF est produit au build par scripts/generate-cv-pdf.mjs a partir de la
// page d'impression correspondante.
const pdfHref = `/assets/pdf/CV_Thibault_Rosalie_${lang.toUpperCase()}.pdf`;
const printHref = lang === 'fr' ? '/cv-print/' : `/${lang}/cv-print/`;
---

<BaseLayout title={t('cv.meta.title')} description={t('cv.meta.desc')}>
	<main id="main-content" tabindex="-1" class="cv-wrapper">
		<div class="cv-actions">
			<a href={pdfHref} download class="button">{t('cv.download')}</a>
			<a href={printHref} target="_blank" rel="noopener">{t('cv.save')}</a>
		</div>

		<CvDocument lang={lang} />
	</main>
</BaseLayout>
