---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';
---

<aside>
	<p>
		{t('contactcta.title')}
		<a href={prefix + '/contact/'}>{t('cta.contact')}</a>
	</p>
</aside>

<style>
	aside {
		/* La largeur du texte et non celle de la page : le filet s'arrete a la colonne. */
		width: calc(100% - 3rem);
		max-width: 73rem;
		margin: 5rem auto 0;
		padding: 2.5rem 0;
		border-top: 1px solid var(--rule);
	}

	p {
		max-width: 30ch;
		font-size: var(--step-3);
		font-weight: 600;
		line-height: 1.25;
	}

	@media (min-width: 50em) {
		aside {
			width: calc(100% - 6rem);
			max-width: 70rem;
			margin-top: 7rem;
			padding: 3.5rem 0;
		}

		p {
			max-width: none;
		}
	}
</style>
