---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import LangToggle from './LangToggle.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: t('nav.home'), href: prefix + '/' },
	{ label: t('nav.work'), href: prefix + '/work/' },
	// « À propos » est masquée tant que son texte n'est pas écrit (src/pages/_about.astro).
	{ label: t('nav.cv'), href: prefix + '/cv/' },
	{ label: t('nav.contact'), href: prefix + '/contact/' },
];

/** Profils : les seules icones de la navigation, chacune nommee pour les lecteurs d'ecran. */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'GitHub', href: 'https://github.com/trosalie', icon: 'github-logo' },
	{ label: 'LinkedIn', href: 'https://linkedin.com/in/thibaultrosalie', icon: 'linkedin-logo' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	// La racine locale (/ ou /en/) ne doit pas matcher toutes les sous-pages
	const isLocaleRoot = href === '/' || /^\/[a-z]{2}\/$/.test(href);
	return pathname === href || (!isLocaleRoot && pathname.startsWith(href));
};
---

<nav>
	<div class="menu-header">
		<a href={prefix + '/'} class="site-title">Thibault Rosalie</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	{/* Sans JavaScript, le menu reste cache : les profils restent atteignables ici. */}
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			<LangToggle />
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		position: relative;
		z-index: 9999;
		max-width: 76rem;
		margin-inline: auto;
		margin-bottom: 3rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
	}

	.site-title {
		font-size: var(--step-1);
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}

	.menu-button {
		display: flex;
		padding: 0.45rem;
		border: 1px solid var(--ink-muted);
		border-radius: var(--radius);
		background: transparent;
		color: var(--ink);
		font-size: 1.25rem;
		cursor: pointer;
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
		background: var(--wall);
		border-bottom: 1px solid var(--rule);
	}

	.nav-items {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 1rem 1.5rem 1.5rem;
		list-style: none;
		font-size: var(--step-1);
	}

	.link {
		color: var(--ink);
		text-decoration: none;
	}

	.link:hover {
		text-decoration: underline;
	}

	.link[aria-current='page'] {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}

	.menu-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.5rem 1.5rem;
		border-top: 1px solid var(--rule);
	}

	.socials {
		display: flex;
		gap: 0.25rem;
		font-size: 1.25rem;
	}

	.social {
		display: flex;
		padding: 0.4rem;
		color: var(--ink-muted);
	}

	.social:hover {
		color: var(--ink);
	}

	@media (min-width: 50em) {
		nav {
			display: flex;
			align-items: center;
			gap: 2.5rem;
			padding: 1.75rem 3rem;
			margin-bottom: 4.5rem;
		}

		.menu-header {
			padding: 0;
		}

		.menu-content {
			display: contents;
		}

		.nav-items {
			flex-direction: row;
			gap: 1.75rem;
			padding: 0;
			margin-inline-start: auto;
			font-size: var(--step--1);
		}

		.menu-footer {
			gap: 1.25rem;
			padding: 0;
			border: 0;
		}

		.socials {
			font-size: 1.1rem;
		}
	}

	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>
