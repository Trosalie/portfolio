---
const currentYear = new Date().getFullYear();
---

<footer>
	<p>&copy; {currentYear} Thibault Rosalie</p>
	<p class="socials">
		<a href="https://github.com/trosalie">GitHub</a>
		<a href="https://linkedin.com/in/thibaultrosalie">LinkedIn</a>
	</p>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		/* La largeur du texte et non celle de la page : le filet s'arrete a la colonne. */
		width: calc(100% - 3rem);
		max-width: 73rem;
		margin: auto auto 0;
		padding: 2rem 0;
		border-top: 1px solid var(--rule);
		color: var(--ink-muted);
		font-size: var(--step--1);
	}

	.socials {
		display: flex;
		gap: 1.25rem;
	}

	footer a {
		color: inherit;
	}

	footer a:hover {
		color: var(--ink);
	}

	@media (min-width: 50em) {
		footer {
			width: calc(100% - 6rem);
			max-width: 70rem;
			padding: 2.5rem 0;
		}
	}
</style>
