---
/**
 * La page A4 du CV, dans les deux langues.
 *
 * Pas de BaseLayout : ni nav, ni footer, ni fonds de page. C'est cette page
 * que Puppeteer charge pour produire les PDF (scripts/generate-cv-pdf.mjs),
 * et qui s'ouvre dans un nouvel onglet depuis le bouton « Sauvegarder en PDF »
 * de la page CV.
 */

import { getLangFromUrl, useTranslations } from '../i18n/ui';
import CvDocument from './CvDocument.astro';
import PrintToolbar from './PrintToolbar.astro';
// Polices embarquées, et non chargées depuis Google Fonts : ce sont exactement
// les fichiers de l'outil candidatures (src/template/fonts.ts), mêmes graisses.
// Les PDF publics sont produits en CI sous Linux ; avec d'autres fichiers de
// police, un CV plein pourrait y passer à deux pages sans que l'outil l'ait vu.
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/rubik/300.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/700.css';
import '../styles/cv-print.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const backHref = lang === 'fr' ? '/cv/' : `/${lang}/cv/`;
---

<html lang={lang}>
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="robots" content="noindex, nofollow" />
	<title>{t('cv.print.title')}</title>
</head>
<body>
	<PrintToolbar title={t('cv.print.toolbar')} backHref={backHref} />

	<div class="cv-page-wrapper">
		<CvDocument lang={lang} variant="print" />
	</div>
</body>
</html>
