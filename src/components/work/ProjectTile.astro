---
import { workBasePath, type WorkEntry } from '../../data/work';
import type { Lang } from '../../i18n/ui';
import ProjectCartel from './ProjectCartel.astro';
import ProjectFrame, { type TileSize } from './ProjectFrame.astro';

/**
 * La vignette d'un projet : un seul lien, le cadre puis l'etiquette.
 *
 * `wide` : un projet phare, l'etiquette a cote du cadre sur grand ecran.
 * `small` : un projet du BUT, dans une rangee de trois.
 */
interface Props {
	entry: WorkEntry;
	lang: Lang;
	size?: TileSize;
	withDescription?: boolean;
}

const { entry, lang, size = 'card', withDescription = false } = Astro.props;
---

<a class:list={['tile', size]} href={`${workBasePath(lang)}${entry.id}`}>
	<ProjectFrame entry={entry} variant="tile" size={size} />
	<ProjectCartel entry={entry} withDescription={withDescription} />
</a>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	/* Sans `subgrid` (voir global.css), les cadres d'une meme rangee s'etirent a la
	   meme hauteur ; l'etiquette garde la largeur de son texte, comme un cartel
	   pose sous l'oeuvre. */
	.tile > :global(.project-frame) {
		flex: 1;
	}

	.tile > :global(.cartel) {
		align-self: flex-start;
	}

	.tile:hover :global(.cartel-head strong) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Plus etroite, l'etiquette de BluePoint depasserait son cadre. 58rem, la place d'un
	   phare sur un ecran de 64em ; en rem et sur la vignette (voir global.css), le texte
	   agrandi compte aussi. */
	@container (min-width: 58rem) {
		.tile.wide {
			display: grid;
			grid-template-columns: 3fr 2fr;
			gap: 2.5rem;
		}

		/* Le cartel se pose au pied de l'oeuvre, a cote d'elle ; le cadre ne s'etire
		   pas pour l'atteindre. */
		.tile.wide > :global(.project-frame),
		.tile.wide > :global(.cartel) {
			align-self: end;
		}
	}
</style>
