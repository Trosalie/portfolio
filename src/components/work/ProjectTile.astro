---
import { workBasePath, type WorkEntry } from '../../data/work';
import type { Lang } from '../../i18n/ui';
import ProjectCartel from './ProjectCartel.astro';
import ProjectFrame from './ProjectFrame.astro';

/** La vignette d'un projet : un seul lien, le cadre puis l'etiquette. */
interface Props {
	entry: WorkEntry;
	lang: Lang;
	featured?: boolean;
	withDescription?: boolean;
}

const { entry, lang, featured = false, withDescription = false } = Astro.props;
---

<a class:list={['tile', { featured }]} href={`${workBasePath(lang)}${entry.id}`}>
	<ProjectFrame entry={entry} variant="tile" featured={featured} />
	<ProjectCartel entry={entry} withDescription={withDescription} />
</a>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	/* Les cadres d'une meme rangee prennent la meme hauteur, qu'ils aient ou non
	   un nom en tete ; l'etiquette garde la largeur de son texte, comme un
	   cartel pose sous l'oeuvre. */
	.tile > :global(.project-frame) {
		flex: 1;
	}

	.tile > :global(.cartel) {
		align-self: flex-start;
	}

	.tile:hover :global(.cartel-head strong) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (min-width: 50em) {
		.tile.featured {
			display: grid;
			grid-template-columns: 3fr 2fr;
			gap: 2.5rem;
		}

		/* Mis en avant, le cartel se pose au pied de l'oeuvre, a cote d'elle. */
		.tile.featured > :global(.cartel) {
			align-self: end;
		}
	}
</style>
