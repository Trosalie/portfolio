---
import { getAlternateLangPath, getLangFromUrl, type Lang } from '../i18n/ui';

/**
 * Deux liens texte, FR et EN. Celui de la langue courante pointe vers la page
 * courante et porte `aria-current` ; l'autre mene a la page equivalente dans
 * l'autre langue. L'ancien interrupteur se presentait comme un `switch`, alors
 * qu'activer le lien change de page et non d'etat.
 */
const lang = getLangFromUrl(Astro.url);
const alternatePath = getAlternateLangPath(Astro.url);

// La page d'erreur n'existe que sous la forme 404.html : son lien courant
// mene a l'accueil, comme le fait deja le lien de l'autre langue.
const isErrorPage = /\/404\/?$/.test(Astro.url.pathname);
const currentPath = isErrorPage ? (lang === 'en' ? '/en/' : '/') : Astro.url.pathname;

// Le nom complet est lu par les lecteurs d'ecran ; il commence par les deux
// lettres visibles, ce qui garde l'etiquette visible dans le nom (WCAG 2.5.3).
const languages: { code: Lang; label: string; name: string }[] = [
	{ code: 'fr', label: 'FR', name: 'Français' },
	{ code: 'en', label: 'EN', name: 'English' },
];
---

<div class="lang">
	{
		languages.map(({ code, label, name }) =>
			code === lang ? (
				<a href={currentPath} hreflang={code} lang={code} aria-current="page" aria-label={name}>{label}</a>
			) : (
				<a href={alternatePath} hreflang={code} lang={code} aria-label={name}>{label}</a>
			),
		)
	}
</div>

<style>
	.lang {
		display: flex;
		gap: 0.75rem;
		font-size: var(--step--1);
		font-weight: 600;
	}

	a {
		color: var(--ink-muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	a[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}
</style>
