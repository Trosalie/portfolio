---
import { getAlternateLangPath, getLangFromUrl, type Lang } from '../i18n/ui';

/**
 * Deux liens texte, FR et EN. Celui de la langue courante pointe vers la page
 * courante et porte `aria-current` ; l'autre mene a la page equivalente dans
 * l'autre langue. L'ancien interrupteur se presentait comme un `switch`, alors
 * qu'activer le lien change de page et non d'etat.
 */
const lang = getLangFromUrl(Astro.url);
const alternatePath = getAlternateLangPath(Astro.url);

const languages: { code: Lang; label: string }[] = [
	{ code: 'fr', label: 'FR' },
	{ code: 'en', label: 'EN' },
];
---

<div class="lang">
	{
		languages.map(({ code, label }) =>
			code === lang ? (
				<a href={Astro.url.pathname} hreflang={code} lang={code} aria-current="page">{label}</a>
			) : (
				<a href={alternatePath} hreflang={code} lang={code}>{label}</a>
			),
		)
	}
</div>

<style>
	.lang {
		display: flex;
		gap: 0.75rem;
		font-size: var(--step--1);
		font-weight: 600;
	}

	a {
		color: var(--ink-muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	a[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}
</style>
