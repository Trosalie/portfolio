---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import PageTransition from './PageTransition.astro';
import { getAlternateLangPath, getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
	title = t('meta.default.title'),
	description = t('meta.default.description'),
} = Astro.props;

// URLs absolues, construites depuis la cle `site` de astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(getAlternateLangPath(Astro.url), Astro.site);
// Une carte par langue, generee par scripts/generate-og-images.mjs.
const ogImage = new URL(`/og-${lang}.jpg`, Astro.site);

// Le site n'existe qu'en deux langues : la page courante est l'une, la page
// alternee est l'autre.
const frUrl = lang === 'fr' ? canonical : alternate;
const enUrl = lang === 'en' ? canonical : alternate;
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={frUrl} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Thibault Rosalie" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'fr_FR'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t('meta.og.alt')} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="color-scheme" content="light" />

<PageTransition />
