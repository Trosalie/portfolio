---
import { Image } from 'astro:assets';

import Icon from './Icon.astro';
import { projectYear, type WorkEntry } from '../data/work';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	project: WorkEntry;
	basePath?: string;
	lang: Lang;
	/** Mise en avant du projet le plus recent : pleine largeur, image a gauche. */
	featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const { data, id } = project;
const basePath = Astro.props.basePath ?? '/work/';
const t = useTranslations(lang);

const meta = [projectYear(project), data.context].filter(Boolean) as string[];
---

<a class:list={['card', { featured }]} href={`${basePath}${id}`}>
	{/* Le degrade du projet tient lieu de couverture tant qu'aucune capture
	    n'est fournie : la carte reste pleine, jamais vide. */}
	<div class="media" style={`background: ${data.gradient ?? 'var(--gradient-subtle)'}`}>
		{
			data.img && (
				<Image
					src={data.img}
					alt={data.img_alt!}
					width={704}
					height={396}
					widths={[352, 704, 1056]}
					sizes={featured ? '(min-width: 50em) 34rem, 100vw' : '(min-width: 50em) 40vw, 100vw'}
					loading="lazy"
					decoding="async"
				/>
			)
		}
		{featured && <span class="badge">{t('work.card.featured')}</span>}
	</div>
	<div class="body">
		<p class="meta">
			{meta.map((item, index) => (
				<>
					{index > 0 && <span class="sep" aria-hidden="true">·</span>}
					<span>{item}</span>
				</>
			))}
		</p>
		<span class="title">{data.title}</span>
		<p class="description">{data.description}</p>
		<ul class="tags">
			{data.tags.map((tag) => <li class="tag">{tag}</li>)}
		</ul>
		{
			data.githubUrl && (
				<span class="repo">
					<Icon icon="github-logo" />
				</span>
			)
		}
	</div>
</a>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--gray-999);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: inherit;
		transition:
			box-shadow var(--theme-transition),
			border-color var(--theme-transition),
			transform var(--theme-transition);
	}

	.card:hover,
	.card:focus-visible {
		box-shadow: var(--shadow-md);
		border-color: var(--accent-regular);
	}

	.media {
		position: relative;
		aspect-ratio: 16 / 9;
		flex: none;
		overflow: hidden;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease-out;
	}

	.badge {
		position: absolute;
		inset-block-start: 0.75rem;
		inset-inline-start: 0.75rem;
		padding: 0.25rem 0.75rem;
		border-radius: 999rem;
		background: var(--gray-999);
		color: var(--accent-regular);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.sep {
		color: var(--gray-500);
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.2;
		color: var(--gray-0);
	}

	.description {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tag {
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		color: var(--gray-300);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		white-space: nowrap;
	}

	/* Simple reperage : le depot est atteint depuis la page du projet, la carte
	   entiere reste un seul lien. */
	.repo {
		position: absolute;
		inset-block-end: 1.25rem;
		inset-inline-end: 1.25rem;
		color: var(--gray-400);
	}

	.repo :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.card:hover,
		.card:focus-visible {
			transform: translateY(-2px);
		}

		.card:hover img,
		.card:focus-visible img {
			transform: scale(1.03);
		}
	}

	@media (min-width: 50em) {
		.card {
			border-radius: 1.5rem;
		}

		.body {
			padding: 1.5rem;
			gap: 0.6rem;
		}

		.description {
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.title {
			font-size: var(--text-xl);
		}

		/* Le projet mis en avant passe en deux colonnes : la couverture gagne en
		   surface sans que la carte devienne haute. */
		.card.featured {
			flex-direction: row;
			align-items: stretch;
		}

		.card.featured .media {
			flex: 0 0 50%;
			aspect-ratio: auto;
		}

		.card.featured .body {
			flex: 1;
			justify-content: center;
			padding: 2.5rem;
		}

		.card.featured .title {
			font-size: var(--text-2xl);
		}

		.card.featured .description {
			-webkit-line-clamp: 4;
			font-size: var(--text-base);
		}
	}
</style>
