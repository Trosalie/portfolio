---
import { render, type CollectionEntry } from 'astro:content';

import ContactCTA from '../components/ContactCTA.astro';
import FeatureGrid from '../components/project/FeatureGrid.astro';
import IdentitySpecimen from '../components/project/IdentitySpecimen.astro';
import ProjectCover from '../components/project/ProjectCover.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import RoleCallout from '../components/project/RoleCallout.astro';
import StackTable from '../components/project/StackTable.astro';
import BaseLayout from './BaseLayout.astro';
import { normalizeFeatures, type WorkEntry } from '../data/work';
import { useTranslations, type Lang } from '../i18n/ui';

/**
 * La page d'un projet, pour les deux langues.
 *
 * L'ordre des sections sert la personne qui recrute : ce qu'est le projet,
 * puis ce que Thibault y a fait, avant le detail des fonctionnalites. Le
 * nuancier n'apparait que pour un projet qui a une identite visuelle.
 */
interface Props {
	entry: WorkEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);

// `render` est surchargee par collection et n'accepte pas l'union directement ;
// les deux collections partagent le meme schema, la forme rendue est identique.
const { Content } = await render(entry as CollectionEntry<'work'>);

// Le corps Markdown ne porte plus les sections : il ne sert qu'a un complement
// libre, et la section correspondante disparait s'il est vide.
const hasExtraContent = Boolean(entry.body?.trim());

const features = normalizeFeatures(entry.data.features);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<main id="main-content" tabindex="-1" class="wrapper">
		<div class="project">
			<ProjectHero entry={entry} lang={lang} />
			{/* Sans capture, pas de couverture : un cadre vide sous le titre ne
			    ferait que le repeter. */}
			{entry.data.img && <ProjectCover entry={entry} />}

			<ProjectSection title={t('work.section.about')}>
				<p class="intro">{entry.data.intro}</p>
			</ProjectSection>

			<ProjectSection title={t('work.section.role')}>
				<RoleCallout text={entry.data.role} />
			</ProjectSection>

			{
				entry.data.identity && (
					<ProjectSection title={t('work.section.identity')}>
						<IdentitySpecimen identity={entry.data.identity} lang={lang} />
					</ProjectSection>
				)
			}

			<ProjectSection title={t('work.section.features')}>
				<FeatureGrid features={features} />
			</ProjectSection>

			<ProjectSection title={t('work.section.stack')}>
				<StackTable stack={entry.data.stack} />
			</ProjectSection>

			{
				entry.data.gallery && (
					<ProjectSection title={t('work.section.gallery')}>
						<ProjectGallery gallery={entry.data.gallery} lang={lang} />
					</ProjectSection>
				)
			}

			{
				hasExtraContent && (
					<ProjectSection title={t('work.section.more')}>
						<div class="prose">
							<Content />
						</div>
					</ProjectSection>
				)
			}
		</div>
	</main>
	<ContactCTA />
</BaseLayout>

<style>
	.project {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		/* Plus etroit que le `.wrapper` du site : au-dela, les lignes de texte
		   deviennent trop longues et la couverture ecrase le reste de la page. */
		max-width: 66rem;
	}

	.intro {
		max-width: var(--measure);
		font-size: var(--step-1);
		line-height: 1.6;
	}

	/* Styles du contenu Markdown libre. */
	.prose {
		max-width: var(--measure);
		overflow-wrap: break-word;
	}

	.prose > :global(* + *) {
		margin-top: 1rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-inline-start: 1.25rem;
	}

	.prose :global(li + li) {
		margin-top: 0.5rem;
	}

	.prose :global(code) {
		padding: 0.1em 0.35em;
		border-radius: var(--radius);
		background: var(--paper);
		font-size: 0.9em;
	}

	.prose :global(pre) {
		padding: 1rem 1.25rem;
		background: var(--paper);
		overflow-x: auto;
	}

	.prose :global(pre code) {
		padding: 0;
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.6rem 0.75rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--rule);
	}

	.prose :global(th) {
		font-weight: 600;
	}

	.prose :global(img) {
		border-radius: 2px;
	}

	.prose :global(blockquote) {
		padding-inline-start: 1.25rem;
		border-inline-start: 2px solid var(--ink);
		font-size: var(--step-2);
	}

	@media (min-width: 50em) {
		.project {
			gap: 4.5rem;
		}
	}
</style>
