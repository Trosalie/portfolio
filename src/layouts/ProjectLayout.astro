---
import { render, type CollectionEntry } from 'astro:content';

import ContactCTA from '../components/ContactCTA.astro';
import FeatureGrid from '../components/project/FeatureGrid.astro';
import ProjectCover from '../components/project/ProjectCover.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import RoleCallout from '../components/project/RoleCallout.astro';
import StackTable from '../components/project/StackTable.astro';
import BaseLayout from './BaseLayout.astro';
import { normalizeFeatures, type WorkEntry } from '../data/work';
import { useTranslations, type Lang } from '../i18n/ui';

/**
 * La page d'un projet, pour les deux langues.
 *
 * Les deux routes `[...slug].astro` etaient auparavant des copies de 250 lignes
 * dont pres de 180 de CSS identique, et leurs libelles etaient codes en dur hors
 * de l'i18n. Tout ce qui ne depend pas de la langue vit desormais ici ; les
 * routes ne font plus que declarer leurs chemins.
 */
interface Props {
	entry: WorkEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);

// `render` est surchargee par collection et n'accepte pas l'union directement ;
// les deux collections partagent le meme schema, la forme rendue est identique.
const { Content } = await render(entry as CollectionEntry<'work'>);

// Le corps Markdown ne porte plus les quatre sections : il ne sert qu'a un
// complement libre, et la section correspondante disparait s'il est vide.
const hasExtraContent = Boolean(entry.body?.trim());

const features = normalizeFeatures(entry.data.features);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="stack gap-20">
		{/* Le <h1> du projet vivait dans un <header> hors du <main>, qui se
		    mappait sur un repere `banner` sans contenir la navigation. */}
		<main id="main-content" tabindex="-1" class="wrapper">
			<div class="project stack gap-10 lg:gap-15">
				<ProjectHero entry={entry} lang={lang} />
				<ProjectCover entry={entry} />

				<ProjectSection title={t('work.section.about')}>
					<p class="intro">{entry.data.intro}</p>
				</ProjectSection>

				<ProjectSection title={t('work.section.features')}>
					<FeatureGrid features={features} />
				</ProjectSection>

				<ProjectSection title={t('work.section.stack')}>
					<StackTable stack={entry.data.stack} />
				</ProjectSection>

				{
					entry.data.gallery && (
						<ProjectSection title={t('work.section.gallery')}>
							<ProjectGallery gallery={entry.data.gallery} lang={lang} />
						</ProjectSection>
					)
				}

				<ProjectSection title={t('work.section.role')}>
					<RoleCallout text={entry.data.role} />
				</ProjectSection>

				{
					hasExtraContent && (
						<ProjectSection title={t('work.section.more')}>
							<div class="prose">
								<Content />
							</div>
						</ProjectSection>
					)
				}
			</div>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.project {
		/* Plus etroit que le `.wrapper` du site : au-dela, les lignes de texte
		   deviennent trop longues et la couverture ecrase le reste de la page. */
		max-width: 66rem;
		margin-inline: auto;
	}

	.intro {
		margin: 0;
		max-width: 68ch;
		font-size: var(--text-md);
		line-height: 1.7;
		color: var(--gray-200);
	}

	/* Styles du contenu Markdown libre. Ils ne s'appliquent plus qu'ici : les
	   quatre sections d'un projet sont rendues par des composants. */
	.prose {
		max-width: 65ch;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.prose > :global(* + *) {
		margin-top: 1rem;
	}

	.prose :global(h3),
	.prose :global(h4),
	.prose :global(h5) {
		margin: 1.5rem 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-inline-start: 1.25rem;
	}

	.prose :global(li + li) {
		margin-top: 0.5rem;
	}

	.prose :global(code) {
		padding: 0.15em 0.4em;
		border: 1px solid var(--gray-800);
		border-radius: 0.35rem;
		background: var(--gray-999);
		font-size: 0.9em;
	}

	.prose :global(pre) {
		padding: 1rem 1.25rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow-x: auto;
	}

	.prose :global(pre code) {
		padding: 0;
		border: none;
		background: none;
	}

	.prose :global(table) {
		width: 100%;
		table-layout: auto;
		border-collapse: separate;
		border-spacing: 0;
		margin: 1.5rem 0;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		background: color-mix(in srgb, var(--gray-999) 92%, var(--gray-900) 8%);
		box-shadow: var(--shadow-sm);
	}

	.prose :global(table thead) {
		background: color-mix(in srgb, var(--gray-900) 14%, var(--gray-999) 86%);
	}

	.prose :global(table th),
	.prose :global(table td) {
		padding: 0.75rem 1rem;
		text-align: left;
		line-height: 1.4;
		vertical-align: top;
		white-space: normal;
		word-break: break-word;
		border-bottom: 1px solid var(--gray-800);
	}

	.prose :global(table th) {
		font-weight: 700;
		color: var(--gray-100);
	}

	.prose :global(table td) {
		color: var(--gray-200);
	}

	.prose :global(table th + th),
	.prose :global(table td + td) {
		border-left: 1px solid var(--gray-800);
	}

	.prose :global(table tbody tr:last-child td) {
		border-bottom: none;
	}

	.prose :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.prose :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.prose :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.prose :global(a:hover),
	.prose :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.intro {
			font-size: var(--text-lg);
		}

		.prose :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>
