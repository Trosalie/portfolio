---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
// La langue est deduite de l'URL : elle etait codee en dur en "fr", si bien
// que les pages /en/* s'annoncaient comme francaises aux lecteurs d'ecran
// comme aux moteurs de recherche.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html lang={lang}>
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="stack page">
			{/* Premier element focusable du document : il permet de sauter le menu,
			    qui compte une dizaine de liens repetes sur chaque page. La cible
			    `#main-content` est portee par le <main> de chaque page. */}
			<a class="skip-link" href="#main-content">{t('a11y.skipToContent')}</a>
			{/* Le <nav> etait nu : sans <header> parent, le site n'avait aucun
			    repere `banner`, et les <header> internes (accueil, pages projet)
			    en revendiquaient un qui ne contenait pas la navigation. */}
			<header>
				<Nav />
			</header>
			<slot />
			<Footer />
		</div>
	</body>
</html>
